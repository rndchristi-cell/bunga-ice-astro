---
import "../styles/theme.css";
---
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>Keranjang - Bunga Ice and Snack</title>
  </head>
  <body>
    <header>
      <a href="/" class="back-link">← Kembali belanja</a>
      <h1>Keranjang Saya</h1>
    </header>

    <div id="empty-state" style="display:none;">
      <p class="empty-icon">🛒</p>
      <p class="empty-msg">Keranjang masih kosong nih</p>
      <a href="/" class="btn-primary">Mulai Belanja</a>
    </div>

    <main id="cart-list"></main>

    <div id="cart-footer" style="display:none;">
      <div class="total-row">
        <span>Total</span>
        <strong id="cart-total">Rp0</strong>
      </div>
      <a href="/checkout" class="btn-primary">Lanjut Checkout</a>
    </div>

    <script>
      import { getCart, updateQty, removeFromCart, getCartTotal } from "../lib/cart.js";

      function formatRupiah(n) {
        return `Rp${Number(n).toLocaleString("id-ID")}`;
      }

      function render() {
        const cart = getCart();
        const list = document.getElementById("cart-list");
        const empty = document.getElementById("empty-state");
        const footer = document.getElementById("cart-footer");

        if (cart.length === 0) {
          list.innerHTML = "";
          empty.style.display = "block";
          footer.style.display = "none";
          return;
        }

        empty.style.display = "none";
        footer.style.display = "block";

        list.innerHTML = cart
          .map((item) => {
            const chips = item.varianTerpilih
              .map((v) => `<span class="chip">${v.nama_varian}${v.tambah_harga > 0 ? ` (+${formatRupiah(v.tambah_harga)})` : ""}</span>`)
              .join("");

            const fotoHtml = item.foto
              ? `<img src="${item.foto}" alt="${item.namaProduk}" class="cart-item-thumb" />`
              : `<div class="cart-item-thumb no-photo">🍧</div>`;

            return `
              <div class="cart-item" data-cart-id="${item.cartId}">
                ${fotoHtml}
                <div class="cart-item-body">
                  <div class="cart-item-top">
                    <p class="cart-item-name">${item.namaProduk}</p>
                    <button class="remove-btn" data-action="remove">🗑</button>
                  </div>
                  ${chips ? `<div class="chip-row">${chips}</div>` : ""}
                  <div class="cart-item-bottom">
                    <p class="cart-item-harga">${formatRupiah(item.hargaSatuan)}</p>
                    <div class="cart-item-qty">
                      <button class="qty-btn" data-action="dec">−</button>
                      <span>${item.qty}</span>
                      <button class="qty-btn" data-action="inc">+</button>
                    </div>
                  </div>
                </div>
              </div>
            `;
          })
          .join("");

        document.getElementById("cart-total").textContent = formatRupiah(getCartTotal(cart));

        list.querySelectorAll(".cart-item").forEach((el) => {
          const cartId = el.dataset.cartId;
          const item = cart.find((c) => c.cartId === cartId);

          el.querySelector('[data-action="inc"]').addEventListener("click", () => {
            updateQty(cartId, item.qty + 1);
          });
          el.querySelector('[data-action="dec"]').addEventListener("click", () => {
            updateQty(cartId, item.qty - 1);
          });
          el.querySelector('[data-action="remove"]').addEventListener("click", () => {
            removeFromCart(cartId);
          });
        });
      }

      window.addEventListener("cart-updated", render);
      render();
    </script>
  </body>
</html>

<style>
  body {
    font-family: system-ui, sans-serif;
    max-width: 480px; margin: 0 auto; padding: 1rem;
    padding-bottom: 6rem;
  }
  header { margin-bottom: 1rem; }
  .back-link { color: var(--accent); text-decoration: none; font-size: 0.85rem; }
  header h1 { font-size: 1.2rem; margin: 0.5rem 0 0; color: var(--text-color); }

  #empty-state { text-align: center; margin-top: 3rem; }
  .empty-icon { font-size: 3rem; margin: 0; }
  .empty-msg { color: var(--text-muted); margin: 0.5rem 0 1.5rem; }

  .cart-item {
    display: flex; gap: 0.75rem;
    border: 1px solid var(--border-color); border-radius: 10px;
    padding: 0.75rem; margin-bottom: 0.75rem;
    background: var(--card-bg);
  }
  .cart-item-thumb {
    width: 60px; height: 60px; border-radius: 8px;
    object-fit: cover; flex-shrink: 0;
    background: var(--photo-placeholder-bg);
  }
  .cart-item-thumb.no-photo {
    display: flex; align-items: center; justify-content: center;
    font-size: 1.5rem;
  }

  .cart-item-body { flex: 1; min-width: 0; }
  .cart-item-top {
    display: flex; justify-content: space-between; align-items: flex-start;
    gap: 0.5rem;
  }
  .cart-item-name { font-weight: 600; margin: 0; color: var(--text-color); }
  .remove-btn {
    background: none; border: none; font-size: 1rem;
    padding: 0; flex-shrink: 0; opacity: 0.7;
  }

  .chip-row { display: flex; flex-wrap: wrap; gap: 0.3rem; margin: 0.4rem 0; }
  .chip {
    font-size: 0.72rem; color: var(--text-muted);
    background: var(--photo-placeholder-bg);
    padding: 0.15rem 0.5rem; border-radius: 20px;
  }

  .cart-item-bottom {
    display: flex; justify-content: space-between; align-items: center;
    margin-top: 0.4rem;
  }
  .cart-item-harga { font-weight: 700; margin: 0; color: var(--text-color); }

  .cart-item-qty {
    display: flex; align-items: center; gap: 0.5rem;
    background: var(--photo-placeholder-bg);
    border-radius: 20px; padding: 0.15rem 0.3rem;
  }
  .qty-btn {
    width: 24px; height: 24px; border-radius: 50%; border: none;
    background: var(--card-bg); color: var(--text-color); font-size: 0.9rem;
  }
  .cart-item-qty span { color: var(--text-color); font-size: 0.9rem; min-width: 1rem; text-align: center; }

  #cart-footer {
    position: fixed; bottom: 0; left: 0; right: 0;
    background: var(--card-bg); border-top: 1px solid var(--border-color);
    padding: 1rem; max-width: 480px; margin: 0 auto;
  }
  .total-row {
    display: flex; justify-content: space-between;
    margin-bottom: 0.75rem; font-size: 1.1rem; color: var(--text-color);
  }
  .btn-primary {
    display: block; width: 100%; text-align: center;
    background: var(--accent); color: white; padding: 0.75rem;
    border-radius: 6px; text-decoration: none; font-weight: 600;
    box-sizing: border-box;
  }
</style>