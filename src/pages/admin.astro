---
import "../styles/theme.css";
---
<html lang="id">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>Admin Bunga Ice</title></head>
<body>
<main class="admin-shell">
<header class="admin-header"><div><p class="eyebrow">BUNGA ICE AND SNACK</p><h1>Panel Admin</h1><p class="muted">Kelola menu, varian, foto, dan order dengan mudah.</p></div><button id="reload" class="secondary">Muat ulang</button></header>
<section id="login" class="panel"><h2>Login Admin</h2><p class="muted">Masukkan username dan password admin Worker.</p><button id="login-button" class="primary">Login dan buka dashboard</button></section>
<section id="app" hidden>
<nav class="tabs"><button class="tab active" data-tab="products">Produk</button><button class="tab" data-tab="variants">Varian</button><button class="tab" data-tab="orders">Order</button><button class="tab" data-tab="settings">Toko</button></nav>
<section id="status" class="status" hidden></section>
<section id="products" class="tab-panel"></section>
<section id="variants" class="tab-panel" hidden><div class="panel variant-panel"><div class="section-head variant-section-head"><div><p class="section-kicker">PENGATURAN MENU</p><h2>Kelola varian</h2><p class="muted">Atur pilihan rasa, ukuran, topping, atau tambahan untuk setiap menu.</p></div></div><label class="product-picker">Produk<select id="variant-product"></select></label><div id="variant-editor"></div><div class="variant-actions"><button id="add-group" type="button" class="secondary">+ Kelompok varian</button><button id="save-variants" class="primary">Simpan varian</button></div></div></section>
<section id="orders" class="tab-panel" hidden><div class="panel"><div class="section-head"><div><h2>Order terbaru</h2><p class="muted">Order dari database migrasi.</p></div><select id="order-filter"><option value="">Semua status</option><option value="menunggu_bukti">Menunggu bukti</option><option value="diterima">Diterima</option><option value="selesai">Selesai</option><option value="masalah">Masalah</option><option value="dibatalkan">Dibatalkan</option></select></div><div id="order-list"></div></div></section>
<section id="settings" class="tab-panel" hidden><div class="panel"><h2>Pengaturan toko</h2><div id="settings-form"></div><button id="save-settings" class="primary">Simpan pengaturan</button></div></section>
</section></main>
<script>
const API = import.meta.env.PUBLIC_ADMIN_API_URL || "https://bunga-ice-worker.rendychristi.workers.dev";
let auth=sessionStorage.getItem("bungaice_admin_auth")||"", products=[];
const $=id=>document.getElementById(id), esc=v=>String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]));
function status(msg,error=false){const e=$("status");e.hidden=false;e.textContent=msg;e.className=`status ${error?"error":"success"}`;}
async function req(path,opt={}){const r=await fetch(API+path,{...opt,headers:{Authorization:auth,...(opt.headers||{})}});if(r.status===401)throw Error("AUTH");const d=await r.json().catch(()=>({}));if(!r.ok||d.success===false)throw Error(d.error||"Permintaan gagal");return d;}
function productCard(p){return `<article class="product-editor" data-id="${esc(p.id)}"><div class="editor-top"><div><span class="pill">${esc(p.id)}</span><h2>${esc(p.name)}</h2></div><strong class="price-preview">Rp${Number(p.base_price).toLocaleString("id-ID")}</strong></div><label>Nama menu<input data-field="name" value="${esc(p.name)}" /></label><label>Deskripsi<textarea data-field="description" rows="3">${esc(p.description)}</textarea></label><label>Harga<input data-field="base_price" type="number" min="0" step="500" value="${p.base_price}" /></label><div class="switch-row"><label><input data-field="is_active" type="checkbox" ${p.is_active?"checked":""}/> Tampil</label><label><input data-field="is_available" type="checkbox" ${p.is_available?"checked":""}/> Tersedia</label></div><label>Foto baru<input data-upload type="file" accept="image/*"/></label><div class="image-list" data-images>Memuat foto...</div><button class="primary" data-save>Simpan produk</button><small data-result class="muted"></small></article>`;}
async function loadProducts(){const d=await req("/api/admin/products");products=d.products||[];$("products").innerHTML=`<div class="section-head"><div><h2>Produk</h2><p class="muted">${products.length} produk dalam database.</p></div></div><div class="product-grid">${products.map(productCard).join("")}</div>`;$("products").querySelectorAll("[data-save]").forEach(b=>b.onclick=saveProduct);$("variant-product").innerHTML=products.map(p=>`<option value="${p.id}">${esc(p.name)}</option>`).join("");await Promise.all(products.map(p=>loadImages(p.id)));} 
async function loadImages(productId){const card=document.querySelector(`[data-id="${CSS.escape(productId)}"]`),box=card?.querySelector("[data-images]");if(!box)return;const d=await req(`/api/admin/images?product_id=${encodeURIComponent(productId)}`);box.innerHTML=(d.images||[]).map(image=>`<div class="image-row"><span>${esc(image.alt_text||image.object_key.split("/").pop())}</span><button type="button" data-delete-image="${image.id}">Hapus</button></div>`).join("")||`<span class="muted">Belum ada foto</span>`;box.querySelectorAll("[data-delete-image]").forEach(btn=>btn.onclick=async()=>{if(!confirm("Hapus foto ini?"))return;await req(`/api/admin/images/${btn.dataset.deleteImage}`,{method:"DELETE"});await loadImages(productId);status("Foto berhasil dihapus.");});}
async function saveProduct(e){const card=e.target.closest("[data-id]"),id=card.dataset.id,res=card.querySelector("[data-result]");e.target.disabled=true;res.textContent="Menyimpan...";try{await req("/api/admin/products",{method:"PUT",headers:{"Content-Type":"application/json"},body:JSON.stringify({id,name:card.querySelector('[data-field="name"]').value,description:card.querySelector('[data-field="description"]').value,base_price:Number(card.querySelector('[data-field="base_price"]').value),is_active:card.querySelector('[data-field="is_active"]').checked,is_available:card.querySelector('[data-field="is_available"]').checked})});const f=card.querySelector("[data-upload]").files[0];if(f){const form=new FormData();form.append("file",f);form.append("product_id",id);await req("/api/admin/upload",{method:"POST",body:form});}res.textContent="Tersimpan";await loadImages(id);status(`${id} berhasil diperbarui.`);await loadProducts();}catch(x){res.textContent="Gagal";status(x.message,true);}finally{e.target.disabled=false;}}
async function loadVariants(){const id=$("variant-product").value,d=await req(`/api/admin/variants?product_id=${encodeURIComponent(id)}`),by={};(d.groups||[]).forEach(g=>by[g.id]={...g,variants:[]});(d.variants||[]).forEach(v=>by[v.group_id]?.variants.push(v));$("variant-editor").innerHTML=Object.values(by).map(renderGroup).join("");bindVariantControls();}
function renderGroup(g){return `<fieldset class="variant-group" data-group="${esc(g.id||"")}" data-input-type="${esc(g.input_type||"radio")}"><legend class="variant-group-header"><div class="group-heading"><span class="group-label">Kelompok pilihan</span><input class="group-name-input" data-g-name value="${esc(g.name||"Kelompok baru")}" aria-label="Nama kelompok varian"/></div><div class="group-tools"><label class="required-toggle"><input data-g-required type="checkbox" ${g.is_required?"checked":""}/> wajib diisi</label><button type="button" class="group-remove" data-remove-group>Hapus kelompok</button></div></legend><div class="variant-rows">${(g.variants||[]).map(v=>`<div class="variant-row" data-variant="${esc(v.id||"")}"><input data-v-name value="${esc(v.name)}" placeholder="Nama pilihan" aria-label="Nama pilihan"/><input data-v-price type="number" step="500" value="${v.price_delta||0}" placeholder="+ harga" aria-label="Tambahan harga"/><button type="button" data-remove>Hapus</button></div>`).join("")}</div><button type="button" class="secondary add-variant" data-add-variant>+ Tambah pilihan</button></fieldset>`;}
function bindVariantControls(){document.querySelectorAll("#variant-editor [data-remove]").forEach(b=>b.onclick=()=>b.closest(".variant-row").remove());document.querySelectorAll("#variant-editor [data-remove-group]").forEach(b=>b.onclick=()=>{const group=b.closest(".variant-group"),saved=Boolean(group.dataset.group);if(saved&&!confirm("Hapus kelompok varian ini? Perubahan berlaku setelah menekan Simpan varian."))return;group.remove();});document.querySelectorAll("#variant-editor [data-add-variant]").forEach(b=>b.onclick=()=>{const group=b.closest(".variant-group"),rows=group.querySelector(".variant-rows");const row=document.createElement("div");row.className="variant-row";row.dataset.variant="";row.innerHTML=`<input data-v-name placeholder="Nama pilihan" aria-label="Nama pilihan"/><input data-v-price type="number" step="500" value="0" placeholder="+ harga" aria-label="Tambahan harga"/><button type="button" data-remove>Hapus</button>`;rows.append(row);row.querySelector("[data-remove]").onclick=()=>row.remove();});}
function addVariantGroup(){const group={id:"",name:"Kelompok baru",input_type:"radio",is_required:false,variants:[]};$("variant-editor").insertAdjacentHTML("beforeend",renderGroup(group));bindVariantControls();}
async function saveVariants(){const productId=$("variant-product").value,groups=[...document.querySelectorAll("#variant-editor .variant-group")].map((g,i)=>({id:g.dataset.group||undefined,name:g.querySelector("[data-g-name]").value.trim(),input_type:g.dataset.inputType||"radio",is_required:g.querySelector("[data-g-required]").checked,variants:[...g.querySelectorAll(".variant-row")].map((r,j)=>({id:r.dataset.variant||undefined,name:r.querySelector("[data-v-name]").value.trim(),price_delta:Number(r.querySelector("[data-v-price]").value)||0,sort_order:j})).filter(v=>v.name)})).filter(g=>g.name);if(!groups.length)throw Error("Minimal ada satu kelompok varian");await req("/api/admin/variants",{method:"PUT",headers:{"Content-Type":"application/json"},body:JSON.stringify({product_id:productId,groups})});status("Varian berhasil disimpan.");await loadVariants();}
async function loadOrders(){const f=$("order-filter").value,d=await req(`/api/admin/orders${f?`?status=${f}`:""}`);$("order-list").innerHTML=(d.orders||[]).map(o=>`<article class="order-card"><div><strong>${esc(o.order_code)}</strong><span class="pill">${esc(o.status)}</span></div><p>${esc(o.customer_name||"Tanpa nama")} · ${esc(o.pickup_day)} ${esc(o.pickup_time)}</p><strong>Rp${Number(o.total).toLocaleString("id-ID")}</strong><button type="button" class="secondary" data-order-detail="${o.id}">Lihat detail</button><div class="order-detail" data-detail-for="${o.id}" hidden></div><label>Status<select data-order-status="${o.id}">${["menunggu_bukti","diterima","selesai","masalah","dibatalkan"].map(s=>`<option ${s===o.status?"selected":""}>${s}</option>`).join("")}</select></label></article>`).join("")||`<p class="muted">Belum ada order.</p>`;document.querySelectorAll("[data-order-status]").forEach(s=>s.onchange=async()=>{await req(`/api/admin/orders/${s.dataset.orderStatus}/status`,{method:"PUT",headers:{"Content-Type":"application/json"},body:JSON.stringify({status:s.value})});status("Status order diperbarui.");});document.querySelectorAll("[data-order-detail]").forEach(b=>b.onclick=async()=>{const box=document.querySelector(`[data-detail-for="${b.dataset.orderDetail}"]`);if(!box.hidden){box.hidden=true;b.textContent="Lihat detail";return;}const d=await req(`/api/admin/orders/${b.dataset.orderDetail}`);box.innerHTML=(d.items||[]).map(i=>`<div class="detail-line"><span>${esc(i.product_name_snapshot)} × ${i.quantity}<small>${esc(i.variants_json||"[]")}</small></span><strong>Rp${Number(i.subtotal).toLocaleString("id-ID")}</strong></div>`).join("")||`<span class="muted">Tidak ada item.</span>`;box.hidden=false;b.textContent="Tutup detail";});}
async function loadSettings(){const d=await req("/api/admin/settings"),m=Object.fromEntries((d.settings||[]).map(x=>[x.key,x.value]));$("settings-form").innerHTML=["store_name","whatsapp_number","qris_asset_key"].map(k=>`<label>${k}<input data-setting="${k}" value="${esc(m[k]||"")}"/></label>`).join("");}
async function loadAll(){try{if(!auth)return;$("login").hidden=true;$("app").hidden=false;await loadProducts();await loadVariants();await loadOrders();await loadSettings();}catch(x){if(x.message==="AUTH"){auth="";sessionStorage.removeItem("bungaice_admin_auth");$("login").hidden=false;$("app").hidden=true;status("Login tidak valid.",true);}else status(x.message,true);}}
$("add-group").onclick=addVariantGroup;$("login-button").onclick=()=>{const u=prompt("Username admin:");const p=prompt("Password admin:");if(u&&p){auth=`Basic ${btoa(`${u}:${p}`)}`;sessionStorage.setItem("bungaice_admin_auth",auth);loadAll();}};$("reload").onclick=loadAll;$("variant-product").onchange=loadVariants;$("save-variants").onclick=saveVariants;$("order-filter").onchange=loadOrders;$("save-settings").onclick=async()=>{const b=Object.fromEntries([...document.querySelectorAll("[data-setting]")].map(e=>[e.dataset.setting,e.value]));await req("/api/admin/settings",{method:"PUT",headers:{"Content-Type":"application/json"},body:JSON.stringify(b)});status("Pengaturan toko disimpan.");};document.querySelectorAll(".tab").forEach(t=>t.onclick=()=>{document.querySelectorAll(".tab").forEach(x=>x.classList.toggle("active",x===t));document.querySelectorAll(".tab-panel").forEach(x=>x.hidden=x.id!==t.dataset.tab);});loadAll();
</script>
<style>
body{background:#f7f8f4;color:#1c291e;font-family:system-ui,sans-serif}.admin-shell{max-width:1100px;margin:auto;padding:28px 18px 64px}.admin-header,.section-head{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;margin-bottom:22px}.eyebrow{color:#2e7d32;font-weight:800;font-size:12px;letter-spacing:1.5px;margin:0 0 8px}h1{margin:0;font-size:clamp(2rem,5vw,3.2rem);letter-spacing:-.05em}h2{margin:.25rem 0 .5rem}.muted{color:#6e786e}.panel,.product-editor,.order-card{background:#fff;border:1px solid #dfe7da;border-radius:18px;padding:20px;box-shadow:0 12px 30px #1630140d}.variant-panel{padding:clamp(18px,4vw,28px)}.tabs{display:flex;gap:8px;overflow:auto;margin:0 0 18px}.tab,.primary,.secondary,.order-card button{border:0;border-radius:10px;padding:11px 15px;font-weight:800;cursor:pointer}.tab{background:#e7eee4;color:#2e7d32}.tab.active,.primary{background:#2e7d32;color:white}.secondary{background:white;color:#2e7d32;border:1px solid #b9cfb5}.product-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:18px}.product-editor{display:flex;flex-direction:column;gap:13px}.editor-top{display:flex;justify-content:space-between;gap:10px;border-bottom:1px solid #edf1ea;padding-bottom:12px}.price-preview{color:#2e7d32}.pill{display:inline-block;background:#e6f2e2;color:#2e7d32;border-radius:999px;padding:4px 8px;font-size:11px;font-weight:800;margin-right:6px}.section-kicker{margin:0 0 5px;color:#6d7d6b;font-size:11px;font-weight:800;letter-spacing:.12em}label{display:flex;flex-direction:column;gap:6px;font-size:13px;font-weight:700}input,textarea,select{border:1px solid #ccd8c7;border-radius:10px;padding:10px;font:inherit;font-weight:400;background:#fbfcfa}textarea{resize:vertical}.switch-row{display:flex;gap:16px;flex-wrap:wrap}.switch-row label{flex-direction:row;align-items:center;font-weight:600}.switch-row input{accent-color:#2e7d32}.status{margin:0 0 18px;border-radius:10px;padding:12px 14px}.success{background:#e8f5e9;color:#1b5e20}.error{background:#ffebee;color:#b71c1c}.variant-group{border:1px solid #d8e6d4;border-radius:18px;padding:18px;margin:18px 0;background:linear-gradient(180deg,#fff 0%,#fbfdfb 100%);box-shadow:0 8px 22px #1630140b}.variant-group-header{width:100%;display:flex;justify-content:space-between;gap:14px;align-items:flex-end;padding:0 0 14px;margin:0 0 14px;border-bottom:1px solid #edf2ea}.group-heading{min-width:0;flex:1;display:flex;flex-direction:column;gap:5px}.group-label{font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:#718170;font-weight:800}.group-name-input{width:100%;min-width:0;box-sizing:border-box;border:0;border-bottom:2px solid #cbdcc7;border-radius:0;padding:4px 0 6px;background:transparent;color:#1c291e;font-size:18px;font-weight:800;outline:0}.group-name-input:focus{border-bottom-color:#2e7d32;box-shadow:0 2px 0 #2e7d32}.group-tools{display:flex;gap:8px;align-items:center;justify-content:flex-end;flex-wrap:wrap}.required-toggle{display:inline-flex;flex-direction:row;align-items:center;gap:7px;white-space:nowrap;background:#eef6eb;color:#38633b;border:1px solid #d7e8d2;border-radius:999px;padding:8px 10px;font-size:12px;font-weight:800}.required-toggle input{accent-color:#2e7d32}.group-remove{flex:0 0 auto;background:#fff5f5;color:#a33;border:1px solid #e1b6b6;border-radius:9px;padding:9px 11px;font-weight:800;cursor:pointer;transition:background .18s ease,transform .18s ease}.group-remove:hover{background:#ffe9e9}.group-remove:active{transform:scale(.97)}.variant-rows{display:grid;gap:10px}.variant-rows:empty::before{content:"Belum ada pilihan. Tambahkan pilihan pertama di bawah.";display:block;padding:12px;border-radius:11px;background:#f7faf5;color:#788477;font-size:13px}.variant-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px;padding-top:16px;border-top:1px solid #edf2ea}.variant-actions button{flex:1;min-height:46px}.variant-row{display:grid;grid-template-columns:minmax(0,1fr) 112px auto;gap:8px;align-items:center;margin:0;padding:10px;border:1px solid #e5eee2;border-radius:12px;background:#f6faf4}.variant-row input{width:100%;min-width:0;box-sizing:border-box}.variant-row button{min-height:42px;border:1px solid #e1b6b6;background:#fff5f5;color:#a33;border-radius:9px;padding:8px 11px;font-weight:800;white-space:nowrap}.add-variant{width:100%;margin-top:12px;border-style:dashed}.image-list{display:flex;flex-direction:column;gap:6px;padding:8px 0}.image-row{display:flex;justify-content:space-between;gap:8px;align-items:center;font-size:12px}.image-row button{border:1px solid #e1b6b6;background:#fff5f5;color:#a33;border-radius:8px;padding:6px 9px}.order-card{margin:12px 0}.order-detail{margin:10px 0;padding:10px;background:#f4f8f1;border-radius:10px}.detail-line{display:flex;justify-content:space-between;gap:10px;padding:5px 0;border-bottom:1px solid #dfe7da}.detail-line small{display:block;color:#6e786e;max-width:420px;overflow:hidden}.order-card>div{display:flex;align-items:center;gap:8px;justify-content:space-between}.order-card label{margin-top:12px}.order-card select{max-width:240px}@media(max-width:600px){.admin-header{flex-direction:column}.admin-header button{width:100%}.section-head{flex-direction:column}.variant-group-header{flex-direction:column;align-items:stretch}.group-tools{justify-content:space-between}.variant-row{grid-template-columns:minmax(0,1fr) 100px}.variant-row button{grid-column:1/-1;width:100%}.variant-actions{position:sticky;bottom:10px;background:#fff;padding:12px;border:1px solid #dfe7da;border-radius:14px;box-shadow:0 8px 20px #16301418;z-index:2}.variant-actions button{flex:1;min-height:48px}}
</style>
</html>
