---
import "../styles/theme.css";
---
<html lang="id">
<head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>Admin Bunga Ice</title></head>
<body>
<main class="admin-shell">
<header class="admin-header"><div><p class="eyebrow">BUNGA ICE AND SNACK</p><h1>Panel Admin</h1><p class="muted">Kelola menu, varian, foto, dan order tanpa Google Sheet.</p></div><button id="reload" class="secondary">Muat ulang</button></header>
<section id="login" class="panel"><h2>Login Admin</h2><p class="muted">Masukkan username dan password admin Worker.</p><button id="login-button" class="primary">Login dan buka dashboard</button></section>
<section id="app" hidden>
<nav class="tabs"><button class="tab active" data-tab="products">Produk</button><button class="tab" data-tab="variants">Varian</button><button class="tab" data-tab="orders">Order</button><button class="tab" data-tab="settings">Toko</button></nav>
<section id="status" class="status" hidden></section>
<section id="products" class="tab-panel"></section>
<section id="variants" class="tab-panel" hidden><div class="panel"><h2>Kelola varian</h2><label>Produk<select id="variant-product"></select></label><div id="variant-editor"></div><button id="save-variants" class="primary">Simpan varian</button></div></section>
<section id="orders" class="tab-panel" hidden><div class="panel"><div class="section-head"><div><h2>Order terbaru</h2><p class="muted">Order dari database migrasi.</p></div><select id="order-filter"><option value="">Semua status</option><option value="menunggu_bukti">Menunggu bukti</option><option value="diterima">Diterima</option><option value="selesai">Selesai</option><option value="masalah">Masalah</option><option value="dibatalkan">Dibatalkan</option></select></div><div id="order-list"></div></div></section>
<section id="settings" class="tab-panel" hidden><div class="panel"><h2>Pengaturan toko</h2><div id="settings-form"></div><button id="save-settings" class="primary">Simpan pengaturan</button></div></section>
</section></main>
<script>
const API = import.meta.env.PUBLIC_ADMIN_API_URL || "https://bunga-ice-worker.rendychristi.workers.dev";
let auth=sessionStorage.getItem("bungaice_admin_auth")||"", products=[];
const $=id=>document.getElementById(id), esc=v=>String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]));
function status(msg,error=false){const e=$("status");e.hidden=false;e.textContent=msg;e.className=`status ${error?"error":"success"}`;}
async function req(path,opt={}){const r=await fetch(API+path,{...opt,headers:{Authorization:auth,...(opt.headers||{})}});if(r.status===401)throw Error("AUTH");const d=await r.json().catch(()=>({}));if(!r.ok||d.success===false)throw Error(d.error||"Permintaan gagal");return d;}
function productCard(p){return `<article class="product-editor" data-id="${esc(p.id)}"><div class="editor-top"><div><span class="pill">${esc(p.id)}</span><h2>${esc(p.name)}</h2></div><strong class="price-preview">Rp${Number(p.base_price).toLocaleString("id-ID")}</strong></div><label>Nama menu<input data-field="name" value="${esc(p.name)}" /></label><label>Deskripsi<textarea data-field="description" rows="3">${esc(p.description)}</textarea></label><label>Harga<input data-field="base_price" type="number" min="0" step="500" value="${p.base_price}" /></label><div class="switch-row"><label><input data-field="is_active" type="checkbox" ${p.is_active?"checked":""}/> Tampil</label><label><input data-field="is_available" type="checkbox" ${p.is_available?"checked":""}/> Tersedia</label></div><label>Foto baru<input data-upload type="file" accept="image/*"/></label><button class="primary" data-save>Simpan produk</button><small data-result class="muted"></small></article>`;}
async function loadProducts(){const d=await req("/api/admin/products");products=d.products||[];$("products").innerHTML=`<div class="section-head"><div><h2>Produk</h2><p class="muted">${products.length} produk dalam database.</p></div></div><div class="product-grid">${products.map(productCard).join("")}</div>`;$("products").querySelectorAll("[data-save]").forEach(b=>b.onclick=saveProduct);$("variant-product").innerHTML=products.map(p=>`<option value="${p.id}">${esc(p.name)}</option>`).join("");}
async function saveProduct(e){const card=e.target.closest("[data-id]"),id=card.dataset.id,res=card.querySelector("[data-result]");e.target.disabled=true;res.textContent="Menyimpan...";try{await req("/api/admin/products",{method:"PUT",headers:{"Content-Type":"application/json"},body:JSON.stringify({id,name:card.querySelector('[data-field="name"]').value,description:card.querySelector('[data-field="description"]').value,base_price:Number(card.querySelector('[data-field="base_price"]').value),is_active:card.querySelector('[data-field="is_active"]').checked,is_available:card.querySelector('[data-field="is_available"]').checked})});const f=card.querySelector("[data-upload]").files[0];if(f){const form=new FormData();form.append("file",f);form.append("product_id",id);await req("/api/admin/upload",{method:"POST",body:form});}res.textContent="Tersimpan";status(`${id} berhasil diperbarui.`);await loadProducts();}catch(x){res.textContent="Gagal";status(x.message,true);}finally{e.target.disabled=false;}}
async function loadVariants(){const id=$("variant-product").value,d=await req(`/api/admin/variants?product_id=${encodeURIComponent(id)}`),by={};(d.groups||[]).forEach(g=>by[g.id]={...g,variants:[]});(d.variants||[]).forEach(v=>by[v.group_id]?.variants.push(v));$("variant-editor").innerHTML=Object.values(by).map(g=>`<fieldset class="variant-group" data-group="${g.id}"><legend>${esc(g.name)} ${g.is_required?"(wajib)":""}</legend>${g.variants.map(v=>`<div class="variant-row" data-variant="${v.id}"><input data-v-name value="${esc(v.name)}"/><input data-v-price type="number" step="500" value="${v.price_delta}"/><button type="button" data-remove>Hapus</button></div>`).join("")}</fieldset>`).join("");}
async function saveVariants(){const productId=$("variant-product").value,groups=[...document.querySelectorAll(".variant-group")].map((g,i)=>({id:g.dataset.group,name:g.querySelector("legend").textContent.replace(" (wajib)",""),is_required:g.querySelector("legend").textContent.includes("wajib"),variants:[...g.querySelectorAll(".variant-row")].map((r,j)=>({id:r.dataset.variant,name:r.querySelector("[data-v-name]").value,price_delta:Number(r.querySelector("[data-v-price]").value),sort_order:j}))}));await req("/api/admin/variants",{method:"PUT",headers:{"Content-Type":"application/json"},body:JSON.stringify({product_id:productId,groups})});status("Varian berhasil disimpan.");}
async function loadOrders(){const f=$("order-filter").value,d=await req(`/api/admin/orders${f?`?status=${f}`:""}`);$("order-list").innerHTML=(d.orders||[]).map(o=>`<article class="order-card"><div><strong>${esc(o.order_code)}</strong><span class="pill">${esc(o.status)}</span></div><p>${esc(o.customer_name||"Tanpa nama")} · ${esc(o.pickup_day)} ${esc(o.pickup_time)}</p><strong>Rp${Number(o.total).toLocaleString("id-ID")}</strong><label>Status<select data-order-status="${o.id}">${["menunggu_bukti","diterima","selesai","masalah","dibatalkan"].map(s=>`<option ${s===o.status?"selected":""}>${s}</option>`).join("")}</select></label></article>`).join("")||`<p class="muted">Belum ada order.</p>`;document.querySelectorAll("[data-order-status]").forEach(s=>s.onchange=async()=>{await req(`/api/admin/orders/${s.dataset.orderStatus}/status`,{method:"PUT",headers:{"Content-Type":"application/json"},body:JSON.stringify({status:s.value})});status("Status order diperbarui.");});}
async function loadSettings(){const d=await req("/api/admin/settings"),m=Object.fromEntries((d.settings||[]).map(x=>[x.key,x.value]));$("settings-form").innerHTML=["store_name","whatsapp_number","qris_asset_key"].map(k=>`<label>${k}<input data-setting="${k}" value="${esc(m[k]||"")}"/></label>`).join("");}
async function loadAll(){try{if(!auth)return;$("login").hidden=true;$("app").hidden=false;await loadProducts();await loadVariants();await loadOrders();await loadSettings();}catch(x){if(x.message==="AUTH"){auth="";sessionStorage.removeItem("bungaice_admin_auth");$("login").hidden=false;$("app").hidden=true;status("Login tidak valid.",true);}else status(x.message,true);}}
$("login-button").onclick=()=>{const u=prompt("Username admin:");const p=prompt("Password admin:");if(u&&p){auth=`Basic ${btoa(`${u}:${p}`)}`;sessionStorage.setItem("bungaice_admin_auth",auth);loadAll();}};$("reload").onclick=loadAll;$("variant-product").onchange=loadVariants;$("save-variants").onclick=saveVariants;$("order-filter").onchange=loadOrders;$("save-settings").onclick=async()=>{const b=Object.fromEntries([...document.querySelectorAll("[data-setting]")].map(e=>[e.dataset.setting,e.value]));await req("/api/admin/settings",{method:"PUT",headers:{"Content-Type":"application/json"},body:JSON.stringify(b)});status("Pengaturan toko disimpan.");};document.querySelectorAll(".tab").forEach(t=>t.onclick=()=>{document.querySelectorAll(".tab").forEach(x=>x.classList.toggle("active",x===t));document.querySelectorAll(".tab-panel").forEach(x=>x.hidden=x.id!==t.dataset.tab);});loadAll();
</script>
<style>
body{background:#f7f8f4;color:#1c291e;font-family:system-ui,sans-serif}.admin-shell{max-width:1100px;margin:auto;padding:28px 18px 64px}.admin-header,.section-head{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;margin-bottom:22px}.eyebrow{color:#2e7d32;font-weight:800;font-size:12px;letter-spacing:1.5px;margin:0 0 8px}h1{margin:0;font-size:clamp(2rem,5vw,3.2rem);letter-spacing:-.05em}h2{margin:.25rem 0 .5rem}.muted{color:#6e786e}.panel,.product-editor,.order-card{background:#fff;border:1px solid #dfe7da;border-radius:18px;padding:20px;box-shadow:0 12px 30px #1630140d}.tabs{display:flex;gap:8px;overflow:auto;margin:0 0 18px}.tab,.primary,.secondary,.order-card button{border:0;border-radius:10px;padding:11px 15px;font-weight:800;cursor:pointer}.tab{background:#e7eee4;color:#2e7d32}.tab.active,.primary{background:#2e7d32;color:white}.secondary{background:white;color:#2e7d32;border:1px solid #b9cfb5}.product-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:18px}.product-editor{display:flex;flex-direction:column;gap:13px}.editor-top{display:flex;justify-content:space-between;gap:10px;border-bottom:1px solid #edf1ea;padding-bottom:12px}.price-preview{color:#2e7d32}.pill{display:inline-block;background:#e6f2e2;color:#2e7d32;border-radius:999px;padding:4px 8px;font-size:11px;font-weight:800;margin-right:6px}label{display:flex;flex-direction:column;gap:6px;font-size:13px;font-weight:700}input,textarea,select{border:1px solid #ccd8c7;border-radius:10px;padding:10px;font:inherit;font-weight:400;background:#fbfcfa}textarea{resize:vertical}.switch-row{display:flex;gap:16px;flex-wrap:wrap}.switch-row label{flex-direction:row;align-items:center;font-weight:600}.switch-row input{accent-color:#2e7d32}.status{margin:0 0 18px;border-radius:10px;padding:12px 14px}.success{background:#e8f5e9;color:#1b5e20}.error{background:#ffebee;color:#b71c1c}.variant-group{border:1px solid #dfe7da;border-radius:12px;padding:12px;margin:14px 0}.variant-row{display:grid;grid-template-columns:1fr 110px auto;gap:7px;margin:8px 0}.variant-row button{border:1px solid #e1b6b6;background:#fff5f5;color:#a33;border-radius:8px}.order-card{margin:12px 0}.order-card>div{display:flex;align-items:center;gap:8px;justify-content:space-between}.order-card label{margin-top:12px}.order-card select{max-width:240px}@media(max-width:600px){.admin-header{flex-direction:column}.admin-header button{width:100%}.section-head{flex-direction:column}.variant-row{grid-template-columns:1fr 90px}.variant-row button{grid-column:1/-1}}
</style>
</html>
