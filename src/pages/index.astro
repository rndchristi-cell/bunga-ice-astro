---
import ProductCard from "../components/ProductCard.astro";
import CartBar from "../components/CartBar.astro";
import { getStoreData, groupVarianByProduk } from "../lib/api.js";
import BannerSlider from "../components/BannerSlider.astro";
import "../styles/theme.css";

const data = await getStoreData();
const produkAktif = data.produk.filter((p) => p.aktif);
const grupVarian = groupVarianByProduk(data.varian);
const kategoriList = [...new Map(produkAktif.map((p) => [p.kategori_id || p.kategori || "Menu", p.kategori || "Menu"])).entries()].map(([id, name]) => ({ id, name }));
const namaToko = data.config?.toko || "Toko";
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>{namaToko}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#ffffff" />
<meta name="apple-mobile-web-app-capable" content="yes" />
  </head>
  <body>
    <header class="site-header">
  <img src="/bunga-ice-logo.png" alt={namaToko} class="site-logo" />
  <h1>{namaToko}</h1>
</header>

<BannerSlider />

    <section class="category-section" aria-label="Filter kategori menu">
      <div class="category-section-head"><span class="category-eyebrow">JELAJAHI MENU</span><span class="category-hint">Pilih kategori</span></div>
      <div id="category-filter" class="category-filter" role="tablist" aria-label="Pilih kategori menu">
        <button type="button" class="category-chip active" data-category="all" aria-selected="true">Semua</button>
        {kategoriList.map((kategori) => <button type="button" class="category-chip" data-category={kategori.id} aria-selected="false">{kategori.name}</button>)}
      </div>
    </section>

    <main class="product-list">
      {produkAktif.map((produk) => <ProductCard produk={produk} grupVarian={grupVarian} />)}
    </main>
    <p id="category-empty" class="category-empty" hidden>Tidak ada menu pada kategori ini.</p>

    <CartBar />

    <div id="lightbox" class="lightbox" style="display:none;">
      <button id="lightbox-close" class="lightbox-close">✕</button>
      <button id="lightbox-prev" class="lightbox-nav lightbox-prev">‹</button>
      <img id="lightbox-img" src="" alt="" />
      <button id="lightbox-next" class="lightbox-nav lightbox-next">›</button>
    </div>

    <script>
      import { addToCart, getCart, getCartCount, getCartTotal } from "../lib/cart.js";

      function formatRupiah(n) {
        return `Rp${Number(n).toLocaleString("id-ID")}`;
      }
      function escapeHtml(value) {
        return String(value ?? "").replace(/[&<>\"']/g, (c) => ({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]));
      }

      let selectedCategory = "all";
      function applyCategoryFilter() {
        const cards = [...document.querySelectorAll(".product-card")];
        let visible = 0;
        cards.forEach((card) => {
          const match = selectedCategory === "all" || card.dataset.kategoriId === selectedCategory || (!card.dataset.kategoriId && card.dataset.kategori === selectedCategory);
          card.hidden = !match;
          if (match) visible += 1;
        });
        document.querySelectorAll(".category-chip").forEach((button) => {
          const active = button.dataset.category === selectedCategory;
          button.classList.toggle("active", active);
          button.setAttribute("aria-selected", String(active));
        });
        const empty = document.getElementById("category-empty");
        if (empty) empty.hidden = visible > 0 || cards.length === 0;
      }
      function bindCategoryFilter() {
        document.querySelectorAll(".category-chip").forEach((button) => button.addEventListener("click", () => {
          selectedCategory = button.dataset.category || "all";
          applyCategoryFilter();
        }));
      }
      function renderCategoryFilter(products) {
        const filter = document.getElementById("category-filter");
        if (!filter) return;
        const unique = [...new Map((products || []).filter((p) => p.aktif !== false).map((p) => [p.kategori_id || p.kategori || "Menu", p.kategori || "Menu"])).entries()];
        filter.innerHTML = `<button type="button" class="category-chip ${selectedCategory === "all" ? "active" : ""}" data-category="all" aria-selected="${selectedCategory === "all"}">Semua</button>${unique.map(([id, name]) => `<button type="button" class="category-chip ${selectedCategory === id ? "active" : ""}" data-category="${escapeHtml(id)}" aria-selected="${selectedCategory === id}">${escapeHtml(name)}</button>`).join("")}`;
        bindCategoryFilter();
        applyCategoryFilter();
      }

      function updateCartBar() {
        const cart = getCart();
        const bar = document.getElementById("cart-bar");
        if (!bar) return;
        const count = getCartCount(cart);
        if (count === 0) {
          bar.style.display = "none";
        } else {
          bar.style.display = "flex";
          document.getElementById("cart-count").textContent = count;
          document.getElementById("cart-total-bar").textContent = formatRupiah(getCartTotal(cart));
        }
      }

      document.querySelectorAll(".product-card").forEach((card) => {
        const hargaDasar = Number(card.dataset.harga);
        const hargaEl = card.querySelector(".harga");
        const selects = card.querySelectorAll(".variant-select");

        function updateHargaTampil() {
          let tambahan = 0;
          selects.forEach((select) => {
            const opt = select.selectedOptions[0];
            if (opt && opt.dataset.tambahHarga) {
              tambahan += Number(opt.dataset.tambahHarga);
            }
          });
          hargaEl.textContent = formatRupiah(hargaDasar + tambahan);
        }

        selects.forEach((select) => select.addEventListener("change", updateHargaTampil));
      });

      async function refreshLiveCatalog() {
        const catalogUrl = import.meta.env.PUBLIC_CATALOG_URL;
        if (!catalogUrl) return;
        try {
          const response = await fetch(`${catalogUrl}${catalogUrl.includes("?") ? "&" : "?"}live=${Date.now()}`, { cache: "no-store" });
          if (!response.ok) return;
          const data = await response.json();
          const variantsByProduct = data.varian || {};
          renderCategoryFilter(data.produk || []);
          for (const product of data.produk || []) {
            const card = document.querySelector(`.product-card[data-id="${CSS.escape(product.id)}"]`);
            if (!card) continue;
            card.dataset.harga = product.harga;
            card.dataset.kategoriId = product.kategori_id || "";
            card.dataset.kategori = product.kategori || "Menu";
            const price = card.querySelector(".harga");
            if (price) price.dataset.basePrice = product.harga;
            const description = card.querySelector(".deskripsi");
            if (description) description.textContent = product.deskripsi || "";
            const groups = variantsByProduct[product.id] || {};
            card.querySelectorAll(".variant-group").forEach((group) => {
              const select = group.querySelector(".variant-select");
              const groupOptions = groups[group.dataset.grup] || [];
              const current = select.value;
              select.innerHTML = groupOptions.map((option) => `<option value="${option.id_varian}" data-tambah-harga="${option.tambah_harga || 0}" data-nama="${escapeHtml(option.nama_varian)}">${escapeHtml(option.nama_varian)}${Number(option.tambah_harga) > 0 ? ` (+${formatRupiah(option.tambah_harga)})` : ""}</option>`).join("");
              select.dataset.wajib = groupOptions[0]?.wajib ? "1" : "0";
              if ([...select.options].some((option) => option.value === current)) select.value = current;
            });
            const photos = (product.foto || []).map((photo) => { try { return new URL(photo, new URL(catalogUrl).origin).href; } catch { return photo; } });
            const carousel = card.querySelector(".photo-carousel");
            if (carousel && photos.length) {
              carousel.dataset.fotos = photos.join(",");
              carousel.querySelector(".photo-track").innerHTML = photos.map((photo, i) => `<img src="${photo}" alt="${escapeHtml(product.nama)}" loading="lazy" class="photo-slide" data-index="${i}" style="display:block;width:100%;height:100%;object-fit:cover;flex:0 0 100%;" />`).join("");
              carousel.querySelector(".photo-dots").innerHTML = photos.map(() => `<span class="dot"></span>`).join("");
            }
          }
          applyCategoryFilter();
        } catch (error) { console.warn("Katalog live gagal dimuat", error); }
      }

      bindCategoryFilter();
      applyCategoryFilter();

      // Ambil ulang data katalog setelah HTML static tampil agar perubahan admin langsung terlihat.
      refreshLiveCatalog();

      // Sinkronisasi dot carousel saat digeser
      document.querySelectorAll(".photo-carousel").forEach((carousel) => {
        const track = carousel.querySelector(".photo-track");
        const dots = carousel.querySelectorAll(".dot");
        if (dots.length === 0) return;
        dots[0].classList.add("active");

        track.addEventListener("scroll", () => {
          const index = Math.round(track.scrollLeft / track.clientWidth);
          dots.forEach((dot, i) => dot.classList.toggle("active", i === index));
        });
      });

      // Indikator banner slider tetap halus dan mengikuti posisi geser.
      document.querySelectorAll(".banner-slider").forEach((slider) => {
        const track = slider.querySelector(".banner-track");
        const dots = [...slider.querySelectorAll("[data-banner-dot]")];
        if (!track || dots.length === 0) return;
        const setActive = (index) => dots.forEach((dot, i) => {
          const active = i === index;
          dot.classList.toggle("active", active);
          dot.setAttribute("aria-selected", String(active));
        });
        track.addEventListener("scroll", () => {
          const index = Math.max(0, Math.min(dots.length - 1, Math.round(track.scrollLeft / track.clientWidth)));
          setActive(index);
        }, { passive: true });
        dots.forEach((dot) => dot.addEventListener("click", () => {
          const index = Number(dot.dataset.bannerDot || 0);
          track.scrollTo({ left: index * track.clientWidth, behavior: "smooth" });
          setActive(index);
        }));
      });

      // Lightbox popup foto
      const lightbox = document.getElementById("lightbox");
      const lightboxImg = document.getElementById("lightbox-img");
      const btnPrev = document.getElementById("lightbox-prev");
      const btnNext = document.getElementById("lightbox-next");
      let currentFotos = [];
      let currentIndex = 0;

      function openLightbox(fotos, index) {
        currentFotos = fotos;
        currentIndex = index;
        lightboxImg.src = currentFotos[currentIndex];
        lightbox.style.display = "flex";
        btnPrev.style.display = currentFotos.length > 1  ? "flex" : "none";
        btnNext.style.display = currentFotos.length > 1  ? "flex" : "none";
      }

      document.querySelectorAll(".photo-slide").forEach((img) => {
        img.addEventListener("click", () => {
          const carousel = img.closest(".photo-carousel");
          const fotos = carousel.dataset.fotos.split(",");
          const index = Number(img.dataset.index);
          openLightbox(fotos, index);
        });
      });

      document.getElementById("lightbox-close").addEventListener("click", () => {
        lightbox.style.display = "none";
      });
      lightbox.addEventListener("click", (e) => {
        if (e.target === lightbox) lightbox.style.display = "none";
      });
      btnPrev.addEventListener("click", () => {
        currentIndex = (currentIndex - 1 + currentFotos.length) % currentFotos.length;
        lightboxImg.src = currentFotos[currentIndex];
      });
      btnNext.addEventListener("click", () => {
        currentIndex = (currentIndex + 1) % currentFotos.length;
        lightboxImg.src = currentFotos[currentIndex];
      });

      document.querySelectorAll(".btn-order").forEach((btn) => {
        btn.addEventListener("click", () => {
          const card = btn.closest(".product-card");
const produkId = card.dataset.id;
const namaProduk = btn.dataset.nama;
const hargaDasar = Number(card.dataset.harga);
const foto = card.dataset.foto || "";

          const groups = card.querySelectorAll(".variant-group");
          const varianTerpilih = [];
          let adaBelumLengkap = false;

          groups.forEach((group) => {
            const select = group.querySelector("select");
            const wajib = select.dataset.wajib === "1";
            if (wajib && !select.value) {
              adaBelumLengkap = true;
              return;
            }
            if (select.value) {
              const opt = select.selectedOptions[0];
              varianTerpilih.push({
                grup: group.dataset.grup,
                id_varian: select.value,
                nama_varian: opt.dataset.nama,
                tambah_harga: Number(opt.dataset.tambahHarga || 0),
              });
            }
          });

          if (adaBelumLengkap) {
            alert("Lengkapi dulu semua pilihan yang wajib (*) ya!");
            return;
          }

          const tambahHargaTotal = varianTerpilih.reduce((sum, v) => sum + v.tambah_harga, 0);
          const hargaSatuan = hargaDasar + tambahHargaTotal;

          addToCart({ produkId, namaProduk, hargaSatuan, varianTerpilih, qty: 1, foto });
          updateCartBar();

          const label = btn.textContent;
          btn.textContent = "✓ Ditambahkan";
          setTimeout(() => (btn.textContent = label), 1000);
        });
      });

      window.addEventListener("cart-updated", updateCartBar);
      updateCartBar();
    </script>
<script>
  if ("serviceWorker" in navigator) {
    navigator.serviceWorker.register("/sw.js");
  }
</script>
  </body>
</html>

<style>
  body {
    font-family: system-ui, sans-serif;
    max-width: 480px; margin: 0 auto; padding: 1rem;
    padding-bottom: 5rem;
  }
  .site-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  margin-bottom: 1rem;
}
.site-logo {
  width: 36px;
  height: 36px;
  object-fit: contain;
  border-radius: 6px;
}
  header h1 { font-size: 1.3rem; text-align: center; color: var(--text-color); }

  .category-section {
    margin: 0 0 1rem;
    padding: 0.85rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.045);
  }
  .category-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.65rem;
  }
  .category-eyebrow {
    color: var(--text-color);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .category-hint {
    color: var(--text-muted);
    font-size: 0.72rem;
  }
  .category-filter {
    display: flex;
    gap: 0.45rem;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 0.1rem;
  }
  .category-filter::-webkit-scrollbar { display: none; }
  .category-chip {
    flex: 0 0 auto;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    padding: 0.5rem 0.85rem;
    background: transparent;
    color: var(--text-color);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
  }
  .category-chip.active {
    border-color: #2e7d32;
    background: #2e7d32;
    color: #fff;
  }
  .category-chip:active { transform: scale(0.97); }
  .product-card[hidden] { display: none; }
  .category-empty {
    margin: 1rem 0;
    padding: 1rem;
    border: 1px dashed var(--border-color);
    border-radius: 12px;
    color: var(--text-muted);
    text-align: center;
  }

  .product-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .lightbox {
    position: fixed; inset: 0; background: rgba(0, 0, 0, 0.9);
    z-index: 100; display: flex; align-items: center; justify-content: center;
  }
  .lightbox img { max-width: 90%; max-height: 80%; object-fit: contain; }
  .lightbox-close {
    position: absolute; top: 1rem; right: 1rem;
    background: none; border: none; color: white; font-size: 1.5rem;
  }
  .lightbox-nav {
    position: absolute; top: 50%; transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.2); border: none; color: white;
    font-size: 1.5rem; width: 44px; height: 44px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
  }
  .lightbox-prev { left: 0.5rem; }
  .lightbox-next { right: 0.5rem; }
</style>
