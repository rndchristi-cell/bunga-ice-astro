---
import ProductCard from "../components/ProductCard.astro";
import CartBar from "../components/CartBar.astro";
import { getStoreData, groupVarianByProduk } from "../lib/api.js";
import BannerSlider from "../components/BannerSlider.astro";
import "../styles/theme.css";

const data = await getStoreData();
const produkAktif = data.produk.filter((p) => p.aktif);
const grupVarian = groupVarianByProduk(data.varian);
const kategoriList = [...new Map(produkAktif.map((p) => [p.kategori_id || p.kategori || "Menu", p.kategori || "Menu"])).entries()].map(([id, name]) => ({ id, name }));
const namaToko = data.config?.toko || "Toko";
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>{namaToko}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#ffffff" />
<meta name="apple-mobile-web-app-capable" content="yes" />
  </head>
  <body>
    <header class="site-header">
  <img src="/bunga-ice-logo.png" alt={namaToko} class="site-logo" />
  <h1>{namaToko}</h1>
</header>

<BannerSlider />

    <section class="category-section" aria-label="Filter kategori menu">
      <button type="button" id="category-toggle" class="category-accordion-toggle" aria-expanded="false" aria-controls="category-filter">
        <span class="category-toggle-copy"><span class="category-eyebrow">JELAJAHI MENU</span><span id="category-current" class="category-current">Semua kategori</span></span>
        <span class="category-chevron" aria-hidden="true">⌄</span>
      </button>
      <div id="category-filter" class="category-picker-overlay" role="dialog" aria-modal="true" aria-label="Pilih kategori menu" hidden>
        <div class="category-picker-sheet">
          <div class="category-picker-head"><div><span class="category-hint">PILIH KATEGORI</span><strong>Kelompok menu</strong></div><button type="button" id="category-close" class="category-close" aria-label="Tutup pilihan kategori">×</button></div>
          <div id="category-options" class="category-options" role="tablist">
            <button type="button" class="category-chip active" data-category="all" aria-selected="true"><span>Semua menu</span><span class="category-radio" aria-hidden="true"></span></button>
            {kategoriList.map((kategori) => <button type="button" class="category-chip" data-category={kategori.id} aria-selected="false"><span>{kategori.name}</span><span class="category-radio" aria-hidden="true"></span></button>)}
          </div>
        </div>
      </div>
    </section>

    <main class="product-list">
      {produkAktif.map((produk) => <ProductCard produk={produk} grupVarian={grupVarian} />)}
    </main>
    <p id="category-empty" class="category-empty" hidden>Tidak ada menu pada kategori ini.</p>

    <CartBar />

    <div id="lightbox" class="lightbox" style="display:none;">
      <button id="lightbox-close" class="lightbox-close">✕</button>
      <button id="lightbox-prev" class="lightbox-nav lightbox-prev">‹</button>
      <img id="lightbox-img" src="" alt="" />
      <button id="lightbox-next" class="lightbox-nav lightbox-next">›</button>
    </div>

    <script>
      import { addToCart, getCart, getCartCount, getCartTotal } from "../lib/cart.js";

      function formatRupiah(n) {
        return `Rp${Number(n).toLocaleString("id-ID")}`;
      }
      function escapeHtml(value) {
        return String(value ?? "").replace(/[&<>\"']/g, (c) => ({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]));
      }

      let selectedCategory = "all";
      const categoryToggle = document.getElementById("category-toggle");
      const categoryFilter = document.getElementById("category-filter");
      const categoryOptions = document.getElementById("category-options");
      const categoryCurrent = document.getElementById("category-current");
      function setCategoryOpen(open) {
        if (!categoryToggle || !categoryFilter) return;
        categoryFilter.hidden = !open;
        categoryToggle.setAttribute("aria-expanded", String(open));
        categoryToggle.classList.toggle("is-open", open);
      }
      function updateCategorySummary() {
        const active = document.querySelector(".category-chip.active");
        if (categoryCurrent) categoryCurrent.textContent = active?.textContent?.trim() || "Semua kategori";
      }
      function applyCategoryFilter() {
        const cards = [...document.querySelectorAll(".product-card")];
        let visible = 0;
        cards.forEach((card) => {
          const match = selectedCategory === "all" || card.dataset.kategoriId === selectedCategory || (!card.dataset.kategoriId && card.dataset.kategori === selectedCategory);
          card.hidden = !match;
          if (match) visible += 1;
        });
        document.querySelectorAll(".category-chip").forEach((button) => {
          const active = button.dataset.category === selectedCategory;
          button.classList.toggle("active", active);
          button.setAttribute("aria-selected", String(active));
        });
        const empty = document.getElementById("category-empty");
        if (empty) empty.hidden = visible > 0 || cards.length === 0;
        updateCategorySummary();
      }
      function bindCategoryFilter() {
        document.querySelectorAll(".category-chip").forEach((button) => button.addEventListener("click", () => {
          selectedCategory = button.dataset.category || "all";
          applyCategoryFilter();
          setCategoryOpen(false);
        }));
      }
      function renderCategoryFilter(products) {
        const options = document.getElementById("category-options");
        if (!options) return;
        const unique = [...new Map((products || []).filter((p) => p.aktif !== false).map((p) => [p.kategori_id || p.kategori || "Menu", p.kategori || "Menu"])).entries()];
        options.innerHTML = `<button type="button" class="category-chip ${selectedCategory === "all" ? "active" : ""}" data-category="all" aria-selected="${selectedCategory === "all"}"><span>Semua menu</span><span class="category-radio" aria-hidden="true"></span></button>${unique.map(([id, name]) => `<button type="button" class="category-chip ${selectedCategory === id ? "active" : ""}" data-category="${escapeHtml(id)}" aria-selected="${selectedCategory === id}"><span>${escapeHtml(name)}</span><span class="category-radio" aria-hidden="true"></span></button>`).join("")}`;
        bindCategoryFilter();
        applyCategoryFilter();
      }

      function updateCartBar() {
        const cart = getCart();
        const bar = document.getElementById("cart-bar");
        if (!bar) return;
        const count = getCartCount(cart);
        if (count === 0) {
          bar.style.display = "none";
        } else {
          bar.style.display = "flex";
          document.getElementById("cart-count").textContent = count;
          document.getElementById("cart-total-bar").textContent = formatRupiah(getCartTotal(cart));
        }
      }

      document.querySelectorAll(".product-card").forEach((card) => {
        const hargaDasar = Number(card.dataset.harga);
        const hargaEl = card.querySelector(".harga");
        const selects = card.querySelectorAll(".variant-select");

        function updateHargaTampil() {
          let tambahan = 0;
          selects.forEach((select) => {
            const opt = select.selectedOptions[0];
            if (opt && opt.dataset.tambahHarga) {
              tambahan += Number(opt.dataset.tambahHarga);
            }
          });
          hargaEl.textContent = formatRupiah(hargaDasar + tambahan);
        }

        selects.forEach((select) => select.addEventListener("change", updateHargaTampil));
      });

      async function refreshLiveCatalog() {
        const catalogUrl = import.meta.env.PUBLIC_CATALOG_URL;
        if (!catalogUrl) return;
        try {
          const response = await fetch(`${catalogUrl}${catalogUrl.includes("?") ? "&" : "?"}live=${Date.now()}`, { cache: "no-store" });
          if (!response.ok) return;
          const data = await response.json();
          const variantsByProduct = data.varian || {};
          renderCategoryFilter(data.produk || []);
          for (const product of data.produk || []) {
            const card = document.querySelector(`.product-card[data-id="${CSS.escape(product.id)}"]`);
            if (!card) continue;
            card.dataset.harga = product.harga;
            card.dataset.kategoriId = product.kategori_id || "";
            card.dataset.kategori = product.kategori || "Menu";
            const price = card.querySelector(".harga");
            if (price) price.dataset.basePrice = product.harga;
            const description = card.querySelector(".deskripsi");
            if (description) description.textContent = product.deskripsi || "";
            const groups = variantsByProduct[product.id] || {};
            card.querySelectorAll(".variant-group").forEach((group) => {
              const select = group.querySelector(".variant-select");
              const groupOptions = groups[group.dataset.grup] || [];
              const current = select.value;
              select.innerHTML = groupOptions.map((option) => `<option value="${option.id_varian}" data-tambah-harga="${option.tambah_harga || 0}" data-nama="${escapeHtml(option.nama_varian)}">${escapeHtml(option.nama_varian)}${Number(option.tambah_harga) > 0 ? ` (+${formatRupiah(option.tambah_harga)})` : ""}</option>`).join("");
              select.dataset.wajib = groupOptions[0]?.wajib ? "1" : "0";
              if ([...select.options].some((option) => option.value === current)) select.value = current;
            });
            const photos = (product.foto || []).map((photo) => { try { return new URL(photo, new URL(catalogUrl).origin).href; } catch { return photo; } });
            const carousel = card.querySelector(".photo-carousel");
            if (carousel && photos.length) {
              carousel.dataset.fotos = photos.join(",");
              carousel.querySelector(".photo-track").innerHTML = photos.map((photo, i) => `<img src="${photo}" alt="${escapeHtml(product.nama)}" loading="lazy" class="photo-slide" data-index="${i}" style="display:block;width:100%;height:100%;object-fit:cover;flex:0 0 100%;" />`).join("");
              carousel.querySelector(".photo-dots").innerHTML = photos.map(() => `<span class="dot"></span>`).join("");
            }
          }
          applyCategoryFilter();
        } catch (error) { console.warn("Katalog live gagal dimuat", error); }
      }

      categoryToggle?.addEventListener("click", () => setCategoryOpen(categoryFilter?.hidden));
      document.getElementById("category-close")?.addEventListener("click", () => setCategoryOpen(false));
      categoryFilter?.addEventListener("click", (event) => { if (event.target === categoryFilter) setCategoryOpen(false); });
      document.addEventListener("keydown", (event) => { if (event.key === "Escape" && categoryFilter && !categoryFilter.hidden) setCategoryOpen(false); });
      bindCategoryFilter();
      applyCategoryFilter();

      // Ambil ulang data katalog setelah HTML static tampil agar perubahan admin langsung terlihat.
      refreshLiveCatalog();

      // Sinkronisasi dot carousel saat digeser
      document.querySelectorAll(".photo-carousel").forEach((carousel) => {
        const track = carousel.querySelector(".photo-track");
        const dots = carousel.querySelectorAll(".dot");
        if (dots.length === 0) return;
        dots[0].classList.add("active");

        track.addEventListener("scroll", () => {
          const index = Math.round(track.scrollLeft / track.clientWidth);
          dots.forEach((dot, i) => dot.classList.toggle("active", i === index));
        });
      });

      // Indikator banner slider tetap halus dan mengikuti posisi geser.
      document.querySelectorAll(".banner-slider").forEach((slider) => {
        const track = slider.querySelector(".banner-track");
        const dots = [...slider.querySelectorAll("[data-banner-dot]")];
        if (!track || dots.length === 0) return;
        const setActive = (index) => dots.forEach((dot, i) => {
          const active = i === index;
          dot.classList.toggle("active", active);
          dot.setAttribute("aria-selected", String(active));
        });
        track.addEventListener("scroll", () => {
          const index = Math.max(0, Math.min(dots.length - 1, Math.round(track.scrollLeft / track.clientWidth)));
          setActive(index);
        }, { passive: true });
        dots.forEach((dot) => dot.addEventListener("click", () => {
          const index = Number(dot.dataset.bannerDot || 0);
          track.scrollTo({ left: index * track.clientWidth, behavior: "smooth" });
          setActive(index);
        }));
      });

      // Lightbox popup foto
      const lightbox = document.getElementById("lightbox");
      const lightboxImg = document.getElementById("lightbox-img");
      const btnPrev = document.getElementById("lightbox-prev");
      const btnNext = document.getElementById("lightbox-next");
      let currentFotos = [];
      let currentIndex = 0;

      function openLightbox(fotos, index) {
        currentFotos = fotos.filter(Boolean);
        currentIndex = Math.max(0, Math.min(index, currentFotos.length - 1));
        lightboxImg.src = currentFotos[currentIndex];
        lightboxImg.alt = "Foto produk";
        lightbox.style.display = "flex";
        document.body.style.overflow = "hidden";
        btnPrev.style.display = currentFotos.length > 1 ? "flex" : "none";
        btnNext.style.display = currentFotos.length > 1 ? "flex" : "none";
      }
      function closeLightbox() {
        lightbox.style.display = "none";
        lightboxImg.src = "";
        document.body.style.overflow = "";
      }

      document.addEventListener("click", (event) => {
        const img = event.target.closest?.(".photo-slide");
        if (!img) return;
        const carousel = img.closest(".photo-carousel");
        const fotos = (carousel?.dataset.fotos || [...carousel.querySelectorAll(".photo-slide")].map((photo) => photo.src).join(",")).split(",");
        openLightbox(fotos, Number(img.dataset.index) || 0);
      });

      document.getElementById("lightbox-close").addEventListener("click", closeLightbox);
      lightbox.addEventListener("click", (e) => {
        if (e.target === lightbox) closeLightbox();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && lightbox.style.display !== "none") closeLightbox();
      });
      btnPrev.addEventListener("click", () => {
        currentIndex = (currentIndex - 1 + currentFotos.length) % currentFotos.length;
        lightboxImg.src = currentFotos[currentIndex];
      });
      btnNext.addEventListener("click", () => {
        currentIndex = (currentIndex + 1) % currentFotos.length;
        lightboxImg.src = currentFotos[currentIndex];
      });

      document.querySelectorAll(".btn-order").forEach((btn) => {
        btn.addEventListener("click", () => {
          const card = btn.closest(".product-card");
const produkId = card.dataset.id;
const namaProduk = btn.dataset.nama;
const hargaDasar = Number(card.dataset.harga);
const foto = card.dataset.foto || "";

          const groups = card.querySelectorAll(".variant-group");
          const varianTerpilih = [];
          let adaBelumLengkap = false;

          groups.forEach((group) => {
            const select = group.querySelector("select");
            const wajib = select.dataset.wajib === "1";
            if (wajib && !select.value) {
              adaBelumLengkap = true;
              return;
            }
            if (select.value) {
              const opt = select.selectedOptions[0];
              varianTerpilih.push({
                grup: group.dataset.grup,
                id_varian: select.value,
                nama_varian: opt.dataset.nama,
                tambah_harga: Number(opt.dataset.tambahHarga || 0),
              });
            }
          });

          if (adaBelumLengkap) {
            alert("Lengkapi dulu semua pilihan yang wajib (*) ya!");
            return;
          }

          const tambahHargaTotal = varianTerpilih.reduce((sum, v) => sum + v.tambah_harga, 0);
          const hargaSatuan = hargaDasar + tambahHargaTotal;

          addToCart({ produkId, namaProduk, hargaSatuan, varianTerpilih, qty: 1, foto });
          updateCartBar();

          const label = btn.textContent;
          btn.textContent = "✓ Ditambahkan";
          setTimeout(() => (btn.textContent = label), 1000);
        });
      });

      window.addEventListener("cart-updated", updateCartBar);
      updateCartBar();
    </script>
<script>
  if ("serviceWorker" in navigator) {
    navigator.serviceWorker.register("/sw.js");
  }
</script>
  </body>
</html>

<style>
  body {
    font-family: system-ui, sans-serif;
    max-width: 480px; margin: 0 auto; padding: 1rem;
    padding-bottom: 5rem;
  }
  .site-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  margin-bottom: 1rem;
}
.site-logo {
  width: 36px;
  height: 36px;
  object-fit: contain;
  border-radius: 6px;
}
  header h1 { font-size: 1.3rem; text-align: center; color: var(--text-color); }

  .category-section { margin: 0 0 1rem; padding: 0; border: 1px solid var(--border-color); border-radius: 14px; background: var(--card-bg); overflow: hidden; }
  .category-accordion-toggle { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: .75rem; padding: .9rem; border: 0; background: transparent; color: var(--text-color); font: inherit; text-align: left; cursor: pointer; }
  .category-accordion-toggle:active { background: rgba(255,255,255,.06); }
  .category-toggle-copy { display: flex; flex-direction: column; gap: .2rem; min-width: 0; }
  .category-eyebrow { color: var(--text-muted); font-size: .68rem; font-weight: 800; letter-spacing: .1em; }
  .category-current { color: var(--text-color); font-size: .9rem; font-weight: 750; }
  .category-chevron { color: var(--text-muted); font-size: 1.25rem; line-height: 1; transition: transform .18s ease; }
  .category-accordion-toggle.is-open .category-chevron { transform: rotate(180deg); }
  .category-picker-overlay { position: fixed; inset: 0; z-index: 90; display: flex; align-items: flex-start; justify-content: center; padding: min(22vh, 10rem) 1rem 1rem; background: rgba(0,0,0,.52); backdrop-filter: blur(3px); }
  .category-picker-overlay[hidden] { display: none; }
  .category-picker-sheet { width: min(100%, 420px); overflow: hidden; border: 1px solid var(--border-color); border-radius: 18px; background: var(--card-bg); box-shadow: 0 18px 44px rgba(0,0,0,.3); animation: category-sheet-in .18s ease-out; }
  .category-picker-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.1rem; border-bottom: 1px solid var(--border-color); }
  .category-picker-head>div { display: flex; flex-direction: column; gap: .22rem; }
  .category-hint { color: var(--text-muted); font-size: .68rem; font-weight: 800; letter-spacing: .1em; }
  .category-picker-head strong { color: var(--text-color); font-size: 1rem; }
  .category-close { display: grid; place-items: center; width: 34px; height: 34px; border: 1px solid var(--border-color); border-radius: 50%; background: transparent; color: var(--text-muted); font-size: 1.35rem; line-height: 1; cursor: pointer; }
  .category-options { display: flex; flex-direction: column; gap: .6rem; max-height: min(58vh, 390px); overflow-y: auto; padding: .85rem .9rem 1rem; }
  .category-chip { width: 100%; min-height: 56px; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .9rem 1rem; border: 1px solid var(--border-color); border-radius: 13px; background: rgba(255,255,255,.025); color: var(--text-color); font: inherit; font-size: .98rem; font-weight: 650; text-align: left; cursor: pointer; transition: background .18s ease, border-color .18s ease, transform .12s ease; }
  .category-chip:active { background: rgba(46,125,50,.1); transform: scale(.99); }
  .category-chip.active { border-color: var(--accent); background: rgba(46,125,50,.1); color: var(--accent); }
  .category-radio { flex: 0 0 auto; width: 20px; height: 20px; border: 2px solid var(--text-muted); border-radius: 50%; }
  .category-chip.active .category-radio { border: 6px solid var(--accent); }
  .product-card[hidden] { display: none; }
  .category-empty { margin: 1rem 0; padding: 1rem; border: 1px dashed var(--border-color); border-radius: 12px; color: var(--text-muted); text-align: center; }
  @keyframes category-sheet-in { from { opacity: 0; transform: translateY(-8px) scale(.98); } to { opacity: 1; transform: translateY(0) scale(1); } }

  .product-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .lightbox {
    position: fixed; inset: 0; z-index: 100;
    display: flex; align-items: center; justify-content: center;
    padding: 1.25rem;
    background: rgba(8, 12, 9, 0.92);
    backdrop-filter: blur(6px);
  }
  .lightbox img { max-width: 90%; max-height: 82%; object-fit: contain; border-radius: 12px; box-shadow: 0 18px 50px rgba(0,0,0,.35); }
  .lightbox-close {
    position: absolute; top: 1rem; right: 1rem; z-index: 1;
    width: 42px; height: 42px; border: 1px solid rgba(255,255,255,.28); border-radius: 50%;
    background: rgba(255,255,255,.14); color: white; font-size: 1.35rem; cursor: pointer;
  }
  .lightbox-nav {
    position: absolute; top: 50%; z-index: 1; transform: translateY(-50%);
    display: flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border: 1px solid rgba(255,255,255,.28); border-radius: 50%;
    background: rgba(255,255,255,.14); color: white; font-size: 1.8rem; cursor: pointer;
  }
  .lightbox-prev { left: 0.5rem; }
  .lightbox-next { right: 0.5rem; }
</style>
