---
import "../styles/theme.css";
---
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>Checkout - Bunga Ice and Snack</title>
  </head>
  <body>
    <header>
      <a href="/keranjang" class="back-link">← Kembali ke Pesanan</a>
      <h1>Checkout</h1>
    </header>

    <div id="empty-state" style="display:none;">
      <p class="empty-msg">Pesanan kosong, ga ada yang perlu di-bayar 🛒</p>
      <a href="/" class="btn-primary">Buat Pesanan Baru</a>
    </div>

    <main id="checkout-content" style="display:none;">
      <section class="card-section">
        <h2>Ringkasan Pesanan</h2>
        <div id="ringkasan-list"></div>
        <div class="total-row">
          <span>Total</span>
          <strong id="checkout-total">Rp0</strong>
        </div>
      </section>

      <section class="card-section">
        <h2>Kapan mau diambil?</h2>
        <label class="radio-row">
          <input type="radio" name="ambil" value="hari_ini" checked />
          <span class="radio-icon">☀️</span>
          <span>Hari ini</span>
        </label>
        <label class="radio-row">
          <input type="radio" name="ambil" value="besok" />
          <span class="radio-icon">🌙</span>
          <span>Besok</span>
        </label>
      </section>

      <section class="card-section">
        <h2>Jam pengambilan</h2>
        <select id="jam-ambil" class="jam-select"></select>
      </section>

      <section class="card-section">
        <h2>Catatan (opsional)</h2>
        <textarea
          id="catatan"
          class="catatan-input"
          placeholder="Contoh: less ice, jangan pake sedotan, dll"
          rows="2"
        ></textarea>
      </section>

      <section class="card-section">
        <h2>Data Kontak</h2>
        <label class="input-label" for="nama-pemesan">Nama</label>
        <input type="text" id="nama-pemesan" class="text-input" placeholder="Nama kamu" />

        <label class="input-label" for="no-hp">No. HP (opsional)</label>
        <input type="tel" id="no-hp" class="text-input" placeholder="08xxxxxxxxxx" />
      </section>

      <section class="card-section">
        <h2>Pembayaran (QRIS)</h2>
        <div class="qris-wrapper">
          <img src="/qris-bunga-ice.png" alt="QRIS Bunga Ice and Snack" class="qris-img" />
        </div>
        <a href="/qris-bunga-ice.png" download="QRIS-Bunga-Ice.png" class="btn-download">
          ⬇️ Simpan QRIS
        </a>
        <p class="bayar-note">
          Scan QRIS di atas dari aplikasi bank/e-wallet kamu, atau simpan/screenshot gambar QRIS-nya dulu kalau mau scan dari HP lain.
        </p>
      </section>

      <div class="action-buttons">
        <button id="btn-batal" class="btn-secondary">Batalkan Pesanan</button>
        <button id="btn-konfirmasi" class="btn-primary">Konfirmasi Pesanan</button>
      </div>
    </main>

    <div id="order-done" style="display:none;">
      <p class="done-title">✅ Pesanan Dibuat!</p>
      <p>Kode Pesanan kamu:</p>
      <div class="order-code-row">
        <p class="order-code" id="order-code-display"></p>
        <button id="btn-copy-kode" class="btn-copy">📋 Copy</button>
      </div>
      <p class="done-note">
        Copy kode di atas, lalu kirim ke bot Telegram kami dengan format:<br />
        <strong>"ini bukti kode order [kode kamu]"</strong>
      </p>
      <a id="link-bot" href="https://t.me/bungaiceorder_bot" target="_blank" class="btn-primary">
        💬 Buka Chat Bot Telegram
      </a>
      <a href="/" class="btn-secondary-link">Kembali ke Beranda</a>
    </div>

    <script>
      import { getCart, getCartTotal, clearCart } from "../lib/cart.js";

function formatRupiah(n) {
  return `Rp${Number(n).toLocaleString("id-ID")}`;
}

function generateOrderCode() {
  const now = new Date();
  const tgl = now.toISOString().slice(2, 10).replace(/-/g, "");
  const rand = Math.random().toString(36).slice(2, 6).toUpperCase();
  return `BIS-${tgl}-${rand}`;
}

function generateJamSlots(mode) {
  const select = document.getElementById("jam-ambil");
  select.innerHTML = "";

  const jamMulai = 8, jamSelesai = 20, interval = 30;
  const now = new Date();
  const menitSekarang = now.getHours() * 60 + now.getMinutes();

  for (let menit = jamMulai * 60; menit <= jamSelesai * 60; menit += interval) {
    if (mode === "hari_ini" && menit <= menitSekarang) continue;

    const h = String(Math.floor(menit / 60)).padStart(2, "0");
    const m = String(menit % 60).padStart(2, "0");
    const opt = document.createElement("option");
    opt.value = `${h}:${m}`;
    opt.textContent = `${h}:${m}`;
    select.appendChild(opt);
  }

  if (select.options.length === 0) {
    const opt = document.createElement("option");
    opt.value = "";
    opt.textContent = "Tidak ada jam tersedia";
    select.appendChild(opt);
  }
}

function setupJamAmbil() {
  const radios = document.querySelectorAll('input[name="ambil"]');
  const radioHariIni = document.querySelector('input[name="ambil"][value="hari_ini"]');
  const radioBesok = document.querySelector('input[name="ambil"][value="besok"]');

  const now = new Date();
  const menitSekarang = now.getHours() * 60 + now.getMinutes();
  const jamSelesai = 20 * 60;

  if (menitSekarang >= jamSelesai) {
    radioHariIni.disabled = true;
    radioHariIni.checked = false;
    radioBesok.checked = true;
  }

  const modeAktif = document.querySelector('input[name="ambil"]:checked').value;
  generateJamSlots(modeAktif);

  radios.forEach((radio) => {
    radio.addEventListener("change", () => {
      generateJamSlots(radio.value);
    });
  });
}

function render() {
  const cart = getCart();
  const empty = document.getElementById("empty-state");
  const content = document.getElementById("checkout-content");

  if (cart.length === 0) {
    empty.style.display = "block";
    content.style.display = "none";
    return;
  }

  empty.style.display = "none";
  content.style.display = "block";

  document.getElementById("ringkasan-list").innerHTML = cart
  .map((item) => {
    const varianText = item.varianTerpilih.map((v) => v.nama_varian).join(", ");
    const namaLengkap = varianText ? `${item.namaProduk} (${varianText})` : item.namaProduk;
    const subtotal = item.hargaSatuan * item.qty;
    return `
      <div class="ringkasan-item">
        <span>${item.qty}x ${namaLengkap}</span>
        <span>${formatRupiah(subtotal)}</span>
      </div>
    `;
  })
  .join("");

  document.getElementById("checkout-total").textContent = formatRupiah(getCartTotal(cart));
}

document.getElementById("btn-batal").addEventListener("click", () => {
  if (confirm("Yakin mau batalin pesanan ini?")) {
    clearCart();
    window.location.href = "/";
  }
});

document.getElementById("btn-konfirmasi").addEventListener("click", async () => {
  const cart = getCart();
  const ambil = document.querySelector('input[name="ambil"]:checked').value;
  const jamAmbil = document.getElementById("jam-ambil").value;
  const catatan = document.getElementById("catatan").value.trim();
  const namaPemesan = document.getElementById("nama-pemesan").value.trim();
  const noHp = document.getElementById("no-hp").value.trim();
  const orderCode = generateOrderCode();

  const order = {
    orderCode,
    ambil,
    jamAmbil,
    catatan,
    namaPemesan,
    noHp,
    items: cart,
    total: getCartTotal(cart),
    createdAt: new Date().toISOString(),
  };

  const btnKonfirmasi = document.getElementById("btn-konfirmasi");
  btnKonfirmasi.disabled = true;
  btnKonfirmasi.textContent = "Memproses...";

  try {
    const res = await fetch("https://bunga-ice-worker.rendychristi.workers.dev", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(order),
    });

    if (!res.ok) throw new Error("Gagal kirim order");

    document.getElementById("order-code-display").textContent = orderCode;
    document.getElementById("checkout-content").style.display = "none";
    document.getElementById("order-done").style.display = "block";
    clearCart();
  } catch (err) {
    alert("Gagal memproses pesanan. Coba lagi ya, atau hubungi kami langsung.");
    btnKonfirmasi.disabled = false;
    btnKonfirmasi.textContent = "Konfirmasi Pesanan";
  }
});

document.getElementById("btn-copy-kode").addEventListener("click", async () => {
  const kode = document.getElementById("order-code-display").textContent;
  try {
    await navigator.clipboard.writeText(kode);
    const btn = document.getElementById("btn-copy-kode");
    const label = btn.textContent;
    btn.textContent = "✓ Tersalin";
    setTimeout(() => (btn.textContent = label), 1500);
  } catch (err) {
    alert("Gagal copy. Silakan salin manual ya.");
  }
});

window.addEventListener("cart-updated", render);
setupJamAmbil();
render();
    </script>
  </body>
</html>

<style is:global>
  body {
    font-family: system-ui, sans-serif;
    max-width: 480px; margin: 0 auto; padding: 1rem;
  }
  header { margin-bottom: 1rem; }
  .back-link { color: var(--accent); text-decoration: none; font-size: 0.85rem; }
  header h1 { font-size: 1.2rem; margin: 0.5rem 0 0; color: var(--text-color); }

  .empty-msg { text-align: center; color: var(--text-muted); margin-top: 3rem; }

  .card-section {
    margin-bottom: 1rem;
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 1rem;
    background: var(--card-bg);
  }
  .card-section h2 { font-size: 0.95rem; margin: 0 0 0.6rem; color: var(--text-color); }

  .ringkasan-item {
    display: flex; justify-content: space-between;
    font-size: 0.85rem; margin-bottom: 0.4rem; color: var(--text-color);
  }
  .total-row {
    display: flex; justify-content: space-between;
    font-size: 1.1rem; margin-top: 0.75rem;
    border-top: 1px solid var(--border-color); padding-top: 0.5rem;
    color: var(--text-color); font-weight: 700;
    background: var(--photo-placeholder-bg);
    margin-left: -1rem; margin-right: -1rem; margin-bottom: -1rem;
    padding: 0.75rem 1rem; border-radius: 0 0 10px 10px;
  }

  .radio-row {
    display: flex; align-items: center; gap: 0.5rem;
    border: 1px solid var(--border-color); border-radius: 6px;
    padding: 0.6rem; margin-bottom: 0.5rem;
    color: var(--text-color); background: var(--input-bg);
  }
  .radio-icon { font-size: 1.1rem; }

  .jam-select {
    width: 100%; padding: 0.6rem; border-radius: 6px;
    border: 1px solid var(--border-color); font-size: 1rem; box-sizing: border-box;
    background: var(--input-bg); color: var(--text-color);
  }

  .catatan-input {
    width: 100%; padding: 0.6rem; border-radius: 6px;
    border: 1px solid var(--border-color); font-size: 0.9rem;
    background: var(--input-bg); color: var(--text-color);
    box-sizing: border-box; font-family: inherit; resize: vertical;
  }

  .input-label {
    display: block; font-size: 0.8rem; color: var(--text-muted);
    margin: 0.5rem 0 0.25rem;
  }
  .input-label:first-of-type { margin-top: 0; }
  .text-input {
    width: 100%; padding: 0.6rem; border-radius: 6px;
    border: 1px solid var(--border-color); font-size: 0.9rem;
    background: var(--input-bg); color: var(--text-color);
    box-sizing: border-box;
  }

  .qris-wrapper {
    background: white; border-radius: 8px; padding: 0.75rem;
    display: flex; justify-content: center; margin-bottom: 0.6rem;
  }
  .qris-img {
    width: 100%; max-width: 240px; display: block;
  }
  .btn-download {
    display: block; text-align: center; width: 100%;
    padding: 0.5rem; margin-bottom: 0.6rem;
    border: 1px solid var(--accent); border-radius: 6px;
    color: var(--accent); text-decoration: none; font-weight: 600;
    font-size: 0.85rem; box-sizing: border-box;
  }
  .bayar-note { font-size: 0.8rem; color: var(--text-muted); text-align: center; margin: 0; }

  .action-buttons { display: flex; flex-direction: column; gap: 0.6rem; }
  .btn-primary {
    display: block; width: 100%; text-align: center;
    background: var(--accent); color: white; padding: 0.75rem;
    border-radius: 6px; text-decoration: none; font-weight: 600;
    border: none; font-size: 1rem; box-sizing: border-box;
  }
  .btn-secondary {
    display: block; width: 100%; text-align: center;
    background: var(--card-bg); color: var(--danger); padding: 0.75rem;
    border-radius: 6px; font-weight: 600; border: 1px solid var(--danger);
    font-size: 1rem; box-sizing: border-box;
  }
  .btn-secondary-link {
    display: block; width: 100%; text-align: center;
    color: var(--text-muted); padding: 0.6rem; margin-top: 0.5rem;
    text-decoration: underline; font-size: 0.85rem;
  }

  #order-done { text-align: center; margin-top: 2rem; }
  .done-title { font-size: 1.3rem; font-weight: 700; color: var(--accent); }

  .order-code-row {
    display: flex; align-items: center; gap: 0.5rem;
    margin: 0.75rem 0;
  }
  .order-code {
    flex: 1; font-size: 1.3rem; font-weight: 700; letter-spacing: 1px;
    background: var(--photo-placeholder-bg); color: var(--text-color);
    padding: 0.75rem; border-radius: 8px; margin: 0;
  }
  .btn-copy {
    padding: 0.75rem 0.9rem; border-radius: 8px; border: 1px solid var(--border-color);
    background: var(--card-bg); color: var(--text-color); font-size: 0.85rem;
    font-weight: 600; white-space: nowrap;
  }

  .done-note { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.25rem; line-height: 1.5; }
</style>