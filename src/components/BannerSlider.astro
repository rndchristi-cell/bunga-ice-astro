---
const banners = [
  "/banner-1.webp",
  "/banner-2.webp",
  "/banner-3.webp",
];
---

<div class="banner-slider" aria-label="Banner promosi">
  <div class="banner-track">
    {banners.map((src, i) => (
      <img src={src} alt={`Promo ${i + 1}`} class="banner-slide" data-banner-index={i} />
    ))}
  </div>
  <div class="banner-indicator" role="tablist" aria-label="Pilih banner">
    {banners.map((_, i) => (
      <button type="button" class:list={["banner-dot", i === 0 && "active"]} data-banner-dot={i} role="tab" aria-label={`Tampilkan banner ${i + 1}`} aria-selected={i === 0} />
    ))}
  </div>
</div>

<style>
  .banner-slider {
    position: relative;
    width: 100%;
    overflow: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    margin-bottom: 1rem;
  }
  .banner-slider::-webkit-scrollbar {
    display: none;
  }
  .banner-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .banner-track::-webkit-scrollbar { display: none; }
  .banner-indicator {
    position: absolute;
    left: 50%;
    bottom: 10px;
    display: flex;
    gap: 6px;
    padding: 6px 9px;
    border-radius: 999px;
    background: rgba(20, 29, 22, .34);
    backdrop-filter: blur(7px);
    transform: translateX(-50%);
  }
  .banner-dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, .62);
    cursor: pointer;
    transition: width .18s ease, background .18s ease;
  }
  .banner-dot.active {
    width: 20px;
    background: #fff;
  }
  .banner-slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    width: 100%;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    border-radius: 8px;
  }
  @media (max-width: 600px) {
    .banner-indicator { bottom: 8px; padding: 5px 8px; }
    .banner-dot { width: 6px; height: 6px; }
    .banner-dot.active { width: 17px; }
  }
</style>
