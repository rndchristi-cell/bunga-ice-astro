---
import { formatRupiah } from "../lib/api.js";

const { idProduk, grupNama, opsiList } = Astro.props;
const wajib = opsiList[0]?.wajib === true;
const inputName = `varian__${idProduk}__${grupNama}`;
---

<div class="variant-group" data-produk={idProduk} data-grup={grupNama}>
  <label class="variant-label" for={inputName}>
    {grupNama}
    {wajib && <span class="required" title="Wajib dipilih">*</span>}
  </label>

  <select class="variant-select" id={inputName} name={inputName} data-wajib={wajib ? "1" : "0"}>
    {!wajib && <option value="">— Pilih (opsional) —</option>}
    {
      opsiList.map((opsi) => (
        <option
          value={opsi.id_varian}
          data-tambah-harga={opsi.tambah_harga}
          data-nama={opsi.nama_varian}
        >
          {opsi.nama_varian}
          {opsi.tambah_harga > 0 ? ` (+${formatRupiah(opsi.tambah_harga)})` : ""}
        </option>
      ))
    }
  </select>
</div>

<style>
  .variant-group { margin-top: 0.75rem; }
  .variant-label {
    display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 0.3rem;
    color: var(--text-color);
  }
  .required { color: #e57373; }
  .variant-select {
    width: 100%; padding: 0.5rem; border-radius: 6px;
    border: 1px solid var(--border-color); font-size: 0.9rem;
    background: var(--input-bg); color: var(--text-color);
    box-sizing: border-box;
  }
</style>